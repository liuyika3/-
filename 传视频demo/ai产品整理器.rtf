                    <button className="flex-shrink-0 flex items-center justify-center w-9 h-9 bg-white rounded-full shadow-sm text-purple-600 active:bg-purple-50 transition">\
                      <ExternalLink className="w-4 h-4" />\
                    </button>\
                  )\}\
                </div>\
\
                <div className="bg-white p-4 rounded-[24px] shadow-sm">\
                  <div className="flex items-center justify-between mb-3.5">\
                    <div className="flex items-center gap-1.5 text-purple-600">\
                      <Zap className="w-4 h-4" />\
                      <span className="font-bold text-[13px]">\uc0\u30828 \u26680 \u20215 \u20540 \u27934 \u23519 </span>\
                    </div>\
                    \{/* \uc0\u21093 \u21435 \u21253 \u35013 \u35828 \u20154 \u35805  */\}\
                    <button \
                      onClick=\{() => explainWithFeynman(selectedItem.content || selectedItem.summary)\}\
                      disabled=\{isExplaining\}\
                      className="bg-purple-50 text-purple-700 px-2.5 py-1.5 rounded-full text-[9px] font-bold flex items-center gap-1 active:scale-95 transition disabled:opacity-50"\
                    >\
                      \{isExplaining ? <Loader2 className="w-3 h-3 animate-spin" /> : <MessageCircle className="w-3 h-3" />\}\
                      \uc0\u10024  \u25170 \u25481 \u39640 \u22823 \u19978 \u30340 \u22806 \u34915 \
                    </button>\
                  </div>\
\
                  \{selectedItem.img && (\
                    <div className="w-full h-36 rounded-[18px] overflow-hidden mb-3.5 border border-gray-100">\
                      <img src=\{selectedItem.img\} alt="cover" className="w-full h-full object-cover" />\
                    </div>\
                  )\}\
                  \
                  \{selectedItem.feynmanExplanation && (\
                     <div className="mb-3.5 bg-purple-50/50 border border-purple-100 rounded-2xl p-3.5 relative animate-in fade-in">\
                       <div className="absolute -top-2 -left-2 text-xl">\uc0\u55357 \u56613 </div>\
                       <p className="text-purple-900 text-[13px] font-medium leading-relaxed pt-1.5">\
                         \{selectedItem.feynmanExplanation\}\
                       </p>\
                     </div>\
                  )\}\
\
                  <p className="text-gray-700 text-[13px] leading-relaxed font-medium">\
                    \{selectedItem.content || selectedItem.summary\}\
                  </p>\
                  \
                  <div className="flex flex-wrap gap-1.5 mt-3 pt-3 border-t border-gray-50">\
                    \{selectedItem.tags?.map(tag => (\
                      <span key=\{tag\} className="text-[9px] bg-gray-100 text-gray-600 px-2 py-1 rounded-md font-medium">\
                        \{tag\}\
                      </span>\
                    ))\}\
                  </div>\
                </div>\
\
                \{/* \uc0\u32972 \u26223 \u19982 \u35797 \u29992 \u24314 \u35758  */\}\
                \{selectedItem.reminders && selectedItem.reminders.length > 0 && (\
                  <div className="bg-[#f3e8ff] p-4 rounded-[24px] shadow-sm">\
                    <div className="flex items-center gap-1.5 mb-3 text-purple-700">\
                      <Compass className="w-4 h-4" />\
                      <span className="font-bold text-[13px]">\uc0\u32972 \u26223  & \u34892 \u21160 \u25351 \u21335 </span>\
                    </div>\
                    \{selectedItem.reminders.map((r, i) => (\
                      <div key=\{i\} className="flex items-center gap-2.5 bg-white/60 p-2.5 rounded-xl mb-1.5">\
                        <div className="w-4 h-4 rounded-full border-2 border-purple-400 flex-shrink-0 bg-white flex items-center justify-center">\
                           <div className="w-1 h-1 bg-purple-500 rounded-full"></div>\
                        </div>\
                        <span className="text-[13px] font-semibold text-purple-900 leading-snug">\{r\}</span>\
                      </div>\
                    ))\}\
                  </div>\
                )\}\
\
                \{selectedItem.recommendations && selectedItem.recommendations.length > 0 && (\
                  <div>\
                    <div className="flex items-center gap-1.5 mb-2.5 text-gray-500 px-1">\
                      <Lightbulb className="w-4 h-4" />\
                      <span className="font-bold text-[11px] uppercase tracking-wider">\uc0\u28023 \u22806 \u31454 \u21697 \u29983 \u24577 </span>\
                    </div>\
                    <div className="flex flex-col gap-2.5">\
                      \{selectedItem.recommendations.map((rec, i) => (\
                        <div key=\{i\} className="bg-white p-3.5 rounded-[20px] shadow-sm border border-gray-100 flex items-center justify-between active:scale-95 transition-transform cursor-pointer">\
                          <div className="flex flex-col">\
                            <span className="text-[9px] text-gray-400 font-bold mb-0.5 uppercase">\{rec.type\}</span>\
                            <span className="text-[13px] font-bold text-gray-900">\{rec.title\}</span>\
                          </div>\
                          <div className="w-7 h-7 bg-gray-50 rounded-full flex items-center justify-center">\
                             <ChevronRight className="w-4 h-4 text-gray-400" />\
                          </div>\
                        </div>\
                      ))\}\
                    </div>\
                  </div>\
                )\}\
\
              </div>\
            </div>\
          </div>\
        )\}\
\
      </div>\
    </div>\
  );\
\}}